# Copy to .env; existing provider-only .env files also work with local defaults.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://spyglass:spyglass_local@127.0.0.1:55432/spyglass
REDIS_URL=redis://127.0.0.1:56379/0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=86400
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW_SECONDS=60
POSTGRES_USER=spyglass
POSTGRES_PASSWORD=spyglass_local
POSTGRES_DB=spyglass
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# deepseek uses DEEPSEEK_*; deepseek3 uses the explicitly configured DEEPSEEK3_* chat settings.
LLM_PROVIDER=deepseek
# Only set enabled/disabled if your selected provider supports the thinking object.
LLM_THINKING=provider_default
# Optional additional OpenAI-compatible gateways; replace with your chosen endpoints/models.
GLM_API_KEY=
GLM_BASE_URL=
GLM_MODEL=
DEEPSEEK2_API_KEY=
DEEPSEEK2_BASE_URL=
DEEPSEEK2_MODEL=
# Also used for official DeepSeek Search; search ignores gateway BASE_URL.
DEEPSEEK3_API_KEY=
DEEPSEEK3_BASE_URL=
DEEPSEEK3_MODEL=
GLM2_API_KEY=
GLM2_BASE_URL=
GLM2_MODEL=
# Actual Slice 3 provider/executor limits. Cleanup has a bounded 15-second grace period.
LLM_MAX_CONCURRENCY=3
LLM_REQUEST_TIMEOUT_SECONDS=60
# Partial JSON role overrides, each 100..12000. Defaults: planner2000, collector3000,
# normalizer6000, analyst6000, writer3000, reviewer4000. Explicit call budgets win.
LLM_ROLE_MAX_TOKENS={}
RUN_TIMEOUT_SECONDS=240
RESEARCH_MAX_REPAIRS=2
LOCAL_RUN_CAPACITY=2

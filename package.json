{
  "name": "spyglass",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "lint": "eslint apps/web tests/e2e playwright.config.ts",
    "format": "prettier --write apps/web tests/e2e playwright.config.ts package.json",
    "format:check": "prettier --check apps/web tests/e2e playwright.config.ts package.json",
    "test": "npm run test --workspace apps/web",
    "test:e2e": "playwright test",
    "api:types": "uv run python scripts/export_openapi.py && openapi-typescript .artifacts/openapi.json -o apps/web/src/types/api.generated.ts && prettier --write apps/web/src/types/api.generated.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.8.0",
    "typescript-eslint": "^8.56.0"
  }
}
